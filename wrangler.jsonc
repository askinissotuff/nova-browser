{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-browser",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "NovaProxyContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOVA_PROXY",
        "class_name": "NovaProxyContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NovaProxyContainer"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "previews": {}
}
